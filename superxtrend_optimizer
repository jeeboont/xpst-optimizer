# app.py
# XPST Optimizer v3.3.0 (Streamlit UI)

import streamlit as st
import pandas as pd
from datetime import datetime
from xpst.data_io import download_data, process_uploaded_csv
from xpst.optimize import run_staged_optimization_v33
from xpst.utils import version_badge

__version__ = "3.3.0"
__last_updated__ = "2025-08-21"

st.set_page_config(page_title="XPST Optimizer v3.3.0", page_icon="🎯", layout="wide")

st.markdown(version_badge(__version__, __last_updated__), unsafe_allow_html=True)

# Session state
if 'downloaded_data' not in st.session_state:
    st.session_state.downloaded_data = {}
if 'optimization_results' not in st.session_state:
    st.session_state.optimization_results = {}

# Sidebar — configuration
st.sidebar.header("📊 v3.3.0 Configuration")

data_source = st.sidebar.radio("Data Source", ["Upload CSV", "Yahoo Finance"], index=0)

assets_map = {
    'BTCUSD': {'yf': 'BTC-USD', 'name': 'Bitcoin/USD'},
    'ETHUSD': {'yf': 'ETH-USD', 'name': 'Ethereum/USD'},
    'XAUUSD': {'yf': 'GC=F', 'name': 'Gold/USD'},
    'EURUSD': {'yf': 'EURUSD=X', 'name': 'Euro/USD'},
    'GBPUSD': {'yf': 'GBPUSD=X', 'name': 'GBP/USD'},
    'USDJPY': {'yf': 'USDJPY=X', 'name': 'USD/JPY'},
    'AUDUSD': {'yf': 'AUDUSD=X', 'name': 'AUD/USD'},
    'USDCAD': {'yf': 'USDCAD=X', 'name': 'USD/CAD'},
}

uploaded_files, selected_assets, timeframe, period = None, [], '5m', '7d'

if data_source == "Upload CSV":
    st.sidebar.subheader("📁 Upload CSV Files")
    uploaded_files = st.sidebar.file_uploader(
        "Choose CSV files (time, open, high, low, close, volume)",
        type=['csv'], accept_multiple_files=True
    )
    if uploaded_files:
        st.sidebar.success(f"{len(uploaded_files)} file(s) selected")

else:
    selected_assets = st.sidebar.multiselect(
        "Select Assets",
        options=list(assets_map.keys()),
        default=['EURUSD', 'BTCUSD'],
        format_func=lambda k: f"{k} ({assets_map[k]['name']})"
    )
    col_tf, col_period = st.sidebar.columns(2)
    with col_tf:
        timeframe = st.selectbox("Timeframe", ['1m', '5m', '15m', '30m', '1h'], index=1)
    with col_period:
        period = st.selectbox("Data Period", ['7d', '1mo', '3mo'], index=0)

st.sidebar.markdown("---")
st.sidebar.subheader("⚙️ v3.3.0 Optimization Settings")

optimization_mode = st.sidebar.radio("Optimization Mode", ["Quick", "Standard", "Full"], index=0)

st.sidebar.markdown("### 🔧 Filter Settings")
use_filters = st.sidebar.checkbox("Use Filters in Optimization", value=True)
if use_filters:
    use_xtrend = st.sidebar.checkbox("Use X Trend Filter", value=True)
    use_adx = st.sidebar.checkbox("Use ADX Filter", value=False)
    use_ema = st.sidebar.checkbox("Use EMA Filter", value=False)

    use_htf = False
    xtrend_grey = False
    htf_mode = 'Essential'
    if use_xtrend:
        st.sidebar.markdown("**X Trend MTF Settings:**")
        use_htf = st.sidebar.checkbox("Test HTF Variations", value=True)
        if use_htf:
            xtrend_grey = st.sidebar.checkbox("Require MTF Agreement", value=False)
            htf_mode = st.sidebar.radio("HTF Testing Range", ["Essential", "All"], index=0)
else:
    use_xtrend = use_adx = use_ema = use_htf = xtrend_grey = False
    htf_mode = 'Essential'

optimize_filters = st.sidebar.checkbox("Optimize Filter Parameters", value=True)

st.sidebar.markdown("### 🆕 v3.3.0 Features")
show_reentry_stats = st.sidebar.checkbox("Show Re-Entry Statistics", value=True)
show_xtrend_analysis = st.sidebar.checkbox("Show X-Trend Flip Analysis", value=True)

with st.sidebar.expander("🔧 Advanced Settings"):
    max_bars = st.slider("Max Bars to Process", 200, 2000, 500, 100)
    skip_low_volume = st.checkbox("Skip Low Volume Results (<5 trades)", value=True)

# Main controls
st.markdown("### 📊 Data Management")
c1, c2, c3 = st.columns([1, 1, 1])

with c1:
    if data_source == "Upload CSV":
        if uploaded_files and st.button("📤 Process CSV Files", type="primary", use_container_width=True):
            st.session_state.downloaded_data.clear()
            for f in uploaded_files:
                df = pd.read_csv(f)
                processed = process_uploaded_csv(df, f.name)
                if processed is not None:
                    asset = f.name.replace(".csv", "")
                    st.session_state.downloaded_data[asset] = processed
                    st.success(f"Loaded {asset}: {len(processed)} bars")
        else:
            st.info("👆 Upload CSV files to proceed")
    else:
        if st.button("📥 Download Data", type="primary", use_container_width=True):
            st.session_state.downloaded_data.clear()
            for asset in selected_assets:
                data = download_data(assets_map[asset]['yf'], period=period, interval=timeframe)
                if data is not None:
                    st.session_state.downloaded_data[asset] = data
                    st.success(f"{asset}: {len(data)} bars")

with c2:
    if st.session_state.downloaded_data and st.button("🚀 Run v3.3.0 Optimization", type="primary", use_container_width=True):
        st.session_state.optimization_results.clear()
        for asset, data in st.session_state.downloaded_data.items():
            st.write(f"**Optimizing {asset}…**")
            results = run_staged_optimization_v33(
                data, asset, use_xtrend, use_adx, use_ema, xtrend_grey,
                optimization_mode, use_htf, htf_mode,
                max_bars, skip_low_volume, optimize_filters
            )
            if not results.empty:
                st.session_state.optimization_results[asset] = results
                best = results.iloc[0]
                st.success(f"Best → WinRate {best['win_rate']}% | Profit {best['total_pips']:.1f} pips")

with c3:
    if st.session_state.optimization_results and st.button("📊 Clear Results", use_container_width=True):
        st.session_state.optimization_results.clear()
        st.session_state.downloaded_data.clear()
        st.rerun()

# Loaded data summary
if st.session_state.downloaded_data:
    st.markdown("---")
    st.markdown("### 📈 Loaded Data")
    cols = st.columns(len(st.session_state.downloaded_data))
    for i, (asset, df) in enumerate(st.session_state.downloaded_data.items()):
        with cols[i]:
            metric = f"{len(df)} bars"
            st.metric(label=asset, value=metric)

# Results
if st.session_state.optimization_results:
    st.markdown("---")
    st.markdown("### 🏆 v3.3.0 Optimization Results")

    summary_rows = []
    for asset, res in st.session_state.optimization_results.items():
        b = res.iloc[0]
        summary_rows.append({
            "Asset": asset, "Win Rate": f"{b['win_rate']}%", "Trades": int(b['total_trades']),
            "Total Pips": f"{b['total_pips']:.1f}", "PF": f"{b.get('profit_factor', 0):.2f}",
            "Re-entries": int(b.get('reentry_trades', 0)), "X-Trend Flips": int(b.get('x_trend_flips', 0)),
            "Score": f"{b.get('score', 0):.1f}"
        })
    st.dataframe(pd.DataFrame(summary_rows), use_container_width=True, hide_index=True)

    tabs = st.tabs(list(st.session_state.optimization_results.keys()))
    for tab, asset in zip(tabs, st.session_state.optimization_results.keys()):
        with tab:
            res = st.session_state.optimization_results[asset]
            left, right = st.columns([2, 1])
            with left:
                st.write("**Top 10 Results**")
                cols_show = ['pivot_period', 'atr_factor', 'atr_period', 'htf_timeframe',
                             'total_trades', 'win_rate', 'total_pips', 'profit_factor',
                             'reentry_trades', 'x_trend_flips', 'score']
                cols_show = [c for c in cols_show if c in res.columns]
                st.dataframe(res[cols_show].head(10), use_container_width=True, hide_index=True)
            with right:
                best = res.iloc[0]
                st.write("**📍 Optimal Settings (copy to cTrader)**")
                st.code(f"""// XPST v3.3.0 Settings: {asset}
Pivot Period: {best['pivot_period']}
ATR Factor: {best['atr_factor']}
ATR Period: {best['atr_period']}
Use X Trend: Yes
HTF Multiplier: {best.get('htf_multiplier', 1)}
MTF Agreement: {best.get('mtf_agree', 'No')}
ADX: {best.get('adx_threshold', 25) if 'adx_threshold' in best else 'N/A'}
EMA Period: {best.get('ema_period', 200) if 'ema_period' in best else 'N/A'}
Win Rate: {best['win_rate']}% | Trades: {best['total_trades']} | Profit: {best['total_pips']:.1f} pips | PF: {best.get('profit_factor', 0):.2f}
X-Trend Flips: {best.get('x_trend_flips', 0)} | Re-entries: {best.get('reentry_trades', 0)}""")

                csv = res.to_csv(index=False)
                st.download_button(
                    label=f"📥 Download {asset} CSV",
                    data=csv,
                    file_name=f"xpst_v330_{asset}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv",
                    mime="text/csv"
                )

    # Info panels
    st.markdown("---")
    with st.expander("🆕 What's New in v3.3.0"):
        st.markdown("""
- **Fixed X-Trend flips** (no nextTrend), alternating 0/1 properly
- **Non-repainting Pivot Supertrend** with historical value storage
- **Re-entry** after X-Trend flip exits if PVT trend still aligned
- **MTF X-Trend** with correct time alignment
- Expanded analytics (flip counts, re-entries, exit reason counts)
        """)
else:
    if not st.session_state.downloaded_data:
        st.info("👈 Upload CSVs or pull Yahoo data to start")
    else:
        st.info("✅ Data ready — click **Run v3.3.0 Optimization**")
